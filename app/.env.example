# Translation provider. The prototype called a public endpoint with no key, which is
# rate limited and unusable in production. See Developer handoff notes.md, item 1.
VITE_TRANSLATE_ENDPOINT=https://api.your-provider.example/v2/translate

# Server-side only. Never prefix a secret with VITE_, or it ships in the bundle.
TRANSLATE_API_KEY=

# Public origin, used for canonical URLs, Open Graph tags and the sitemap.
VITE_SITE_ORIGIN=https://campusturkey.com

# WhatsApp business number, international format, digits only.
VITE_WHATSAPP_NUMBER=905550000000
