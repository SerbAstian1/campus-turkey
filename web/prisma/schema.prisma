// Campus Turkey — database schema.
//
// Two rules govern everything below.
//
//   1. Money is an integer count of minor units. Never a float, never a string.
//      `Int` is 32-bit: the ceiling is 2,147,483,647 minor units, i.e. $21.4m on a
//      single row. That is far above any plausible single commission or withdrawal.
//      Aggregates are computed by Postgres `SUM(integer)`, which returns `bigint`, so
//      the total cannot overflow even when the parts cannot individually.
//
//   2. Impossible states are unrepresentable wherever a constraint can say so. The
//      CHECK constraints, the composite foreign key on `commission`, and the
//      append-only trigger on `withdrawal_event` live in `migrations/`, because
//      Prisma's schema language cannot express them. They are not optional
//      decoration — see `migrations/0001_init/migration.sql`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Prisma Migrate needs a direct (unpooled) connection; the runtime client uses the
  // pooled URL above. See Department 20 on serverless connection exhaustion.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------- authentication
//
// Managed by Better Auth. The shapes are the library's; do not hand-edit rows.
// `Partner` hangs off `User` rather than replacing it, so a Campus Turkey staff
// account and a partner account are the same kind of thing to the auth layer and
// different things to the domain.

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?

  /// The primary role, declared rather than inferred.
  ///
  /// Before this column, a user's role was worked out from relations: staff if
  /// `staffRole` was non-null, partner if a `Partner` row pointed back. That is
  /// unreadable at the point of an authorization check and it cannot express a role
  /// with no profile row yet, which is exactly the state an invited user is in.
  /// One user, one role, stated here.
  role          UserRole   @default(STUDENT)

  /// Whether the account may be used, independent of what it may do.
  status        UserStatus @default(ACTIVE)

  /// Staff capability within the money path. **Being retired** — see the note on
  /// `StaffRole`. Kept alongside `role` only until `StaffProfile.department` carries
  /// it, and dropped in a later migration rather than renamed in place.
  staffRole     StaffRole?

  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  sessions       Session[]
  accounts       Account[]
  partner        Partner?
  representative RepresentativeProfile?
  staffProfile   StaffProfile?
  studentProfile StudentProfile?
  actedEvents    WithdrawalEvent[] @relation("EventActor")
  reviewedRepresentativeApplications RepresentativeApplication[] @relation("RepresentativeApplicationReviewer")
  applicationStatusChanges           ApplicationStatusHistory[]  @relation("ApplicationStatusActor")
  uploadedDocuments                  Document[]                  @relation("DocumentUploader")
  reviewedDocuments                  Document[]                  @relation("DocumentReviewer")
  notifications                      Notification[]
  conversations                      ConversationParticipant[]
  sentMessages                       Message[]
  auditEntries                       AuditLog[]                  @relation("AuditActor")

  @@index([role])
  @@index([status])
  @@map("user")
}

/// Brief §8. One primary role per user.
///
/// `PARTNER` and `REPRESENTATIVE` are separate values on purpose and must stay that
/// way even while their permissions are identical: the brief's §4 is explicit that a
/// partner is an organisation and a representative is a person or a territory, and
/// collapsing them now means a migration later to tell them apart in referral
/// attribution and reporting.
enum UserRole {
  STUDENT
  PARTNER
  REPRESENTATIVE
  STAFF
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

/// Brief §9. Whether the account may be used at all.
///
/// Separate from `role` because they answer different questions, and conflating them
/// is how a suspended admin keeps their permissions. Every authorization check reads
/// both.
enum UserStatus {
  /// Created, not yet invited. Cannot sign in.
  PENDING
  /// Invited, has not set a password. Cannot sign in until they do.
  INVITED
  ACTIVE
  /// Temporarily barred. Sessions are refused; the record is untouched.
  SUSPENDED
  /// Permanently closed. Kept for referential integrity, never reactivated.
  DEACTIVATED

  @@map("user_status")
}

/// Brief §13. A staff member's identity and department.
///
/// Introduced now rather than in a later phase because `department` is where
/// `User.staffRole` is going: the brief has no FINANCE role because it has no payout
/// system, and Campus Turkey does. Expressing "may move money" as a department the
/// permission layer reads keeps the brief's role vocabulary intact without losing the
/// distinction the money path depends on.
model StaffProfile {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @unique @db.Uuid
  firstName  String
  lastName   String
  department StaffDepartment @default(OPERATIONS)
  jobTitle   String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@map("staff_profile")
}

/// Brief §13's suggested departments. `FINANCE` additionally carries the payout
/// permissions, which is the one department whose name has authorization meaning.
enum StaffDepartment {
  ADMISSIONS
  STUDENT_SUPPORT
  MEDICAL_TOURISM
  BUSINESS
  PARTNERSHIPS
  OPERATIONS
  MARKETING
  MANAGEMENT
  FINANCE

  @@map("staff_department")
}

/// **Being retired.** Superseded by `UserRole` plus `StaffProfile.department`.
///
/// Retained through one migration so that the backfill has a source to read and any
/// endpoint not yet moved to the permission layer keeps working. Dropping it in the
/// same migration that adds `UserRole` would mean a deploy where the old code is still
/// running against the new schema, which is an outage rather than a refactor.
///
/// Removal is a later migration, once no code reads it.
enum StaffRole {
  /// May read every partner's records. May not approve payouts.
  SUPPORT
  /// May approve and reject withdrawals.
  FINANCE
  /// Everything, including staff management.
  ADMIN

  @@map("staff_role")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every session lookup is by token; every "sign out everywhere" is by user.
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  /// Better Auth writes the hash here. Never a plaintext password.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// ---------------------------------------------------------------------- partners

model Partner {
  id          String   @id @default(uuid()) @db.Uuid
  /// One partner per login. A person who represents two agencies gets two logins;
  /// merging them would make "whose commission is this?" unanswerable.
  userId      String   @unique @db.Uuid
  org         String
  person      String
  role        String
  territory   String
  /// Campus Turkey's named contact for this partner. Rendered in the portal.
  managerName String
  managerRole String
  /// Reporting currency. Every commission and withdrawal for this partner is in it;
  /// mixing currencies inside one balance is how a payout system loses money.
  currency    String   @db.Char(3)
  /// Below this, a withdrawal is refused. Stored per partner because it varies by
  /// payout rail and territory, not globally.
  minimumMinor Int     @default(20000)
  status      PartnerStatus @default(ACTIVE)
  since       DateTime @db.Date
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students       Student[]
  commissions    Commission[]
  applications   Application[]
  payoutMethods  PayoutMethod[]
  withdrawals    Withdrawal[]

  @@index([status])
  /// The target of the composite foreign keys on `commission` and `withdrawal`.
  /// Because those reference `(partner_id, currency)` rather than just `partner_id`,
  /// Postgres refuses any commission or withdrawal denominated in a currency other
  /// than the partner's — and refuses to change a partner's currency while any exist.
  /// Summing mixed currencies into one balance is a money bug that no amount of
  /// careful application code reliably prevents, so it is made unrepresentable here.
  @@unique([id, currency])
  @@map("partner")
}

/// Brief §12. An individual or country-level Campus Turkey representative.
///
/// **Why this is a separate table rather than a flag on `Partner`.** §4 is explicit that
/// the two are different relationships: a partner is an organisation with a commercial
/// agreement, a representative is a person or a territory. They currently do the same
/// work, which is the argument people use for merging them, and it is exactly why
/// merging them now would be expensive later — telling them apart again would mean a
/// migration of live referral attribution.
///
/// The fields diverge from `Partner` where the difference is real: `fullName` rather than
/// `org` plus `person`, because a representative is a person; `organizationName` optional,
/// because they may or may not have one; `territory` rather than `currency` and
/// `minimumMinor`, because representatives are not paid through the payout system.
///
/// A representative earns nothing through `Commission` today. If that changes, this model
/// gains the same `@@unique([id, currency])` composite key `Partner` carries, for the same
/// reason.
model RepresentativeProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  fullName         String
  organizationName String?
  country          String
  email            String
  phone            String?
  address          String?
  /// The market they cover. Free text rather than an enum: territories are commercial
  /// arrangements ("West Africa", "Kano State", "Lagos and Ogun"), not a fixed taxonomy.
  territory        String?
  status           RepresentativeStatus @default(PENDING)
  since            DateTime @db.Date
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  students     Student[]
  applications Application[]

  @@index([status])
  @@index([country])
  @@map("representative_profile")
}

/// Mirrors `PartnerStatus` in shape but not in values: a representative is approved
/// individually, so the lifecycle has an explicit approval step that a partner record
/// (created only after approval) does not need.
enum RepresentativeStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("representative_status")
}

/// Brief §23. An application to become a representative, before any account exists.
///
/// Kept distinct from `Lead` for the reason §22 gives about partners: onboarding is a
/// process with a reviewer and an outcome, not an enquiry someone replies to. A lead is
/// closed; an application is approved or rejected, and the difference is the account it
/// creates.
model RepresentativeApplication {
  id               String   @id @default(uuid()) @db.Uuid
  fullName         String
  organizationName String?
  country          String
  territory        String?
  email            String
  phone            String?
  address          String?
  message          String?
  status           ApplicationReviewStatus @default(PENDING)
  reviewedByUserId String?  @db.Uuid
  reviewedAt       DateTime? @db.Timestamptz(3)
  /// Why it was rejected. Shown to nobody automatically; recorded so a decision can be
  /// explained months later when the applicant asks.
  reviewNote       String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  reviewedBy User? @relation("RepresentativeApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  /// One live application per address. A rejected applicant may apply again, which is why
  /// this is partial rather than a plain unique on `email` — expressed in the migration,
  /// since Prisma cannot describe a partial index.
  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@map("representative_application")
}

/// Shared by the partner and representative application flows. A review has three
/// outcomes and no others; "CONVERTED" belongs on the lead, not here.
enum ApplicationReviewStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@map("application_review_status")
}

/// Brief §14. A university, as a record rather than a content file.
///
/// The directory has lived in `src/content/universities.ts` since the prototype. Moving
/// it here is what §44's server-side filtering and §49's admin CRUD both require — you
/// cannot page, filter or edit a TypeScript array from an admin screen.
///
/// **`tuition` stays a display string.** §15 puts a numeric tuition on `Program`, which
/// is right for filtering, but the directory card shows "$400 – $1,500 / year" and a
/// number cannot say that. Both exist: `tuitionDisplay` for the card, and the numeric
/// range on `Program` for the filter. Collapsing them would either break the card or
/// make the filter lie.
///
/// `slug` keeps the prototype's flawed rule, which mangles Turkish letters
/// (`Boğaziçi` becomes `bo-azi-i`). Those are the addresses already published; fixing
/// the rule means transliterating and redirecting, not swapping.
model University {
  id            String         @id @default(uuid()) @db.Uuid
  slug          String         @unique
  name          String
  city          String
  region        String?
  type          UniversityType
  description   String
  logo          String?
  coverImage    String?
  website       String?
  latitude      Float?
  longitude     Float?
  status        PublishStatus  @default(PUBLISHED)

  /// Directory facts. Display strings where the reader needs a unit or a range, and
  /// integers where something filters or sorts on them.
  languages     String[]
  tuitionDisplay String
  programCount  Int            @default(0)
  scholarship   Boolean        @default(false)
  founded       Int?
  studentsDisplay String?
  ranking       String?
  faculties     String[]
  /// [label, value] intake dates, flattened to two parallel arrays would lose their
  /// pairing, so this is JSON. It is display copy, never queried.
  deadlines     Json?

  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  programs      Program[]
  applications  Application[]

  /// §84's named indexes. `city` and `type` are the directory's two hard filters;
  /// the composite carries the common case of both at once with the published filter.
  @@index([status, city])
  @@index([status, type])
  @@index([city, type])
  @@map("university")
}

enum UniversityType {
  PUBLIC
  PRIVATE

  @@map("university_type")
}

/// Whether a record is visible to the public. Separate from deletion: a university that
/// is being edited, or one Campus Turkey no longer works with, should leave the
/// directory without taking its applications' foreign keys with it.
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

/// Brief §15. A programme within a university.
model Program {
  id            String        @id @default(uuid()) @db.Uuid
  universityId  String        @db.Uuid
  name          String
  slug          String
  degreeLevel   DegreeLevel
  language      String
  /// Display string: "4 years", "2 semesters". Duration is quoted, not computed.
  duration      String?
  /// Minor units, like every other money value in this schema. Nullable because a
  /// programme with no published fee is common and zero would be a lie.
  tuitionMinor  Int?
  currency      String?       @db.Char(3)
  scholarshipAvailable Boolean @default(false)
  description   String?
  status        PublishStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  applications Application[]

  /// Unique per university, not globally: "Medicine" exists at forty institutions.
  @@unique([universityId, slug])
  @@index([universityId])
  @@index([status, degreeLevel])
  @@index([status, language])
  @@index([tuitionMinor])
  @@map("program")
}

enum DegreeLevel {
  FOUNDATION
  BACHELOR
  MASTER
  PHD

  @@map("degree_level")
}

enum PartnerStatus {
  ACTIVE
  /// Can sign in and read, cannot request withdrawals or add students.
  SUSPENDED
  CLOSED

  @@map("partner_status")
}

// ---------------------------------------------------------------------- students

model Student {
  id             String       @id @default(uuid()) @db.Uuid

  /**
   * Who referred this student. Exactly one of these is set, enforced by a CHECK
   * constraint in the migration because Prisma cannot express an exclusive-or.
   *
   * `partnerId` became nullable here, which is the load-bearing change. `Commission`
   * still references `(studentId, partnerId)` through a composite foreign key, and that
   * relation is unaffected: `Commission.partnerId` is NOT NULL, so a commission can only
   * ever resolve to a student who has a partner. A representative-referred student
   * therefore cannot carry a commission, which is correct — representatives are not paid
   * through the payout system.
   */
  partnerId        String?    @db.Uuid
  representativeId String?    @db.Uuid

  /// The account that claimed this referred record, once somebody has.
  ///
  /// Null until then, which is the normal state for most rows: a referral is created by
  /// an agency and may never be claimed at all. This is what keeps "a partner filled in
  /// a form" distinguishable from "a student signed up".
  profileId      String?    @db.Uuid

  /// A single-use code the referrer passes to the student so they can claim this record.
  /// Consumed on claim and never reissued for the same row, which is why it is nullable
  /// rather than permanent.
  claimCode      String?    @unique

  name           String
  /// Denormalised display strings, matching `PortalStudent` in content/types.ts.
  /// The university is referenced by slug rather than by foreign key because the
  /// university catalogue is static content, not a table. If it becomes a table,
  /// this becomes a relation — that migration is additive.
  universitySlug String
  universityName String
  program        String
  stage          StudentStage @default(ENQUIRY)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  partner        Partner?               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  representative RepresentativeProfile? @relation(fields: [representativeId], references: [id], onDelete: Restrict)
  commissions    Commission[]
  applications   Application[]
  profile        StudentProfile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)

  /// Serves `GET /api/partner/students` (list, newest first) and the pipeline
  /// counts, which group by stage within one partner.
  @@index([partnerId, updatedAt(sort: Desc)])
  @@index([partnerId, stage])
  /// The representative portal's list query, mirroring the partner ones above so the
  /// two roles perform identically rather than one being quietly slower.
  @@index([representativeId, updatedAt(sort: Desc)])
  @@index([representativeId, stage])
  @@index([profileId])
  /// The target of `commission`'s composite foreign key. This is what makes the
  /// denormalised `commission.partnerId` provably equal to the student's partner
  /// rather than merely intended to be.
  @@unique([id, partnerId])
  @@map("student")
}

/// Brief §10. A student's own account.
///
/// **This is not `Student`, and the difference is the audit's third Blocker.** `Student`
/// is a record a partner or representative created about somebody they referred: a name,
/// a university, a stage. It has no login, no email and no password, and it exists
/// whether or not that person ever hears about Campus Turkey's portal.
///
/// `StudentProfile` is the person. It hangs off `User`, so they can sign in, and it
/// points back at the referred record they claimed. A referral becomes an account when
/// the student claims it, not before — which is why `Student.profileId` is nullable and
/// why nothing here is created by the referral flow.
///
/// The alternative, bolting `email` and `passwordHash` onto `Student`, would give every
/// referred person a dormant half-account they never asked for, and would make "has this
/// student signed up" indistinguishable from "did the partner fill the form in".
model StudentProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  firstName          String
  lastName           String
  phone              String?
  dateOfBirth        DateTime? @db.Date
  nationality        String
  countryOfResidence String
  /// §10 says do not collect unnecessary sensitive information. A passport number is
  /// needed for a visa application and for nothing before it, so it is nullable and
  /// requested at the visa stage rather than at signup.
  passportNumber     String?
  address            String?
  profilePhoto       String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The referred records this person has claimed. Usually one; more than one happens
  /// when two agencies referred the same person before either reached them.
  claimedStudents Student[]

  @@index([nationality])
  @@map("student_profile")
}

enum StudentStage {
  ENQUIRY
  DOCUMENTS
  SUBMITTED
  OFFER
  VISA
  REGISTERED

  @@map("student_stage")
}

// ------------------------------------------------------------------- commissions

model Commission {
  id          String          @id @default(uuid()) @db.Uuid
  studentId   String          @db.Uuid
  /// Denormalised from `student.partnerId`. Every balance read and every withdrawal
  /// sums commissions for one partner; carrying the partner here removes a join from
  /// the hottest financial query in the system. The composite foreign key below makes
  /// the denormalisation impossible to violate — Postgres rejects a commission whose
  /// partner does not match its student's.
  partnerId   String          @db.Uuid
  amountMinor Int
  currency    String          @db.Char(3)
  state       CommissionState @default(PENDING)
  /// What the money is for, in the partner's language. Shown on the statement.
  basis       String
  /// The billing period this belongs to, e.g. "2026-03". Used to build the
  /// withdrawal's `period` label.
  period      String          @db.VarChar(7)
  /// Set exactly when `state` becomes CONFIRMED. A confirmed commission with no
  /// timestamp is a bug; the CHECK constraint in the migration rejects it.
  confirmedAt DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  student Student @relation(fields: [studentId, partnerId], references: [id, partnerId], onDelete: Restrict)
  partner Partner @relation(fields: [partnerId, currency], references: [id, currency], onDelete: Restrict)

  /// The balance query: `WHERE partner_id = $1 AND state = 'CONFIRMED'`. Partial
  /// indexes for the two states that are summed are declared in the migration —
  /// Prisma cannot express `WHERE` on an index.
  @@index([partnerId, state])
  @@index([studentId])
  @@map("commission")
}

/// Brief §16. The central workflow object.
///
/// An application is what staff actually operate on: it carries the status, the referral
/// attribution, the university and programme, and the history of every decision made
/// about it. A `Student` is a person; an `Application` is what is being done for them.
///
/// **Referral attribution lives here, not on `Student`.** §16 puts `partnerId` and
/// `representativeId` on the application, and it is right: a student referred by one
/// partner for a bachelor's could later apply through a different route for a master's,
/// and attribution belongs to the attempt rather than the person. `Student` keeps its own
/// referral columns for the portals that list "my students", and the two agree because
/// the application copies the student's referrer at creation.
model Application {
  id                String            @id @default(uuid()) @db.Uuid
  /// Human-readable, quoted in emails and on the phone. Generated from a sequence, so
  /// it is unique without a round trip to check.
  applicationNumber String            @unique
  studentId         String            @db.Uuid

  /// Exactly one of these, or neither. A CHECK constraint enforces it; §16 requires it.
  partnerId         String?           @db.Uuid
  representativeId  String?           @db.Uuid

  universityId      String?           @db.Uuid
  programId         String?           @db.Uuid

  status            ApplicationStatus @default(DRAFT)

  submittedAt       DateTime?         @db.Timestamptz(3)
  reviewedAt        DateTime?         @db.Timestamptz(3)
  approvedAt        DateTime?         @db.Timestamptz(3)
  rejectedAt        DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  student        Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  partner        Partner?               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  representative RepresentativeProfile? @relation(fields: [representativeId], references: [id], onDelete: Restrict)
  university     University?            @relation(fields: [universityId], references: [id], onDelete: Restrict)
  program        Program?               @relation(fields: [programId], references: [id], onDelete: Restrict)

  history       ApplicationStatusHistory[]
  documents     Document[]
  conversations Conversation[]

  /// §84 names most of these. The composite pairs are the queries the portals and the
  /// staff console actually run: "my applications, newest first" and "everything in this
  /// status".
  @@index([studentId])
  @@index([partnerId, updatedAt(sort: Desc)])
  @@index([representativeId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([universityId])
  @@index([createdAt])
  @@map("application")
}

/// Brief §8. Fifteen states, and the transitions between them are the server's decision
/// alone — see `application.state.ts`.
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  DOCUMENTS_REVIEW
  APPLICATION_PROCESSING
  UNIVERSITY_SUBMITTED
  ADMISSION_PENDING
  ADMITTED
  ADMISSION_REJECTED
  VISA_PROCESS
  VISA_APPROVED
  VISA_REJECTED
  READY_FOR_TRAVEL
  COMPLETED
  CANCELLED

  @@map("application_status")
}

/// Brief §17. Every important transition, recorded.
///
/// Append-only, enforced by a trigger, exactly as `withdrawal_event` is. This is the
/// record that answers "who moved this application to rejected, and when" months later,
/// and a mutable audit trail cannot answer it.
model ApplicationStatusHistory {
  id              String             @id @default(uuid()) @db.Uuid
  applicationId   String             @db.Uuid
  previousStatus  ApplicationStatus?
  newStatus       ApplicationStatus
  /// Null for a system transition. Nullable rather than absent so the column can say
  /// "nobody" distinctly from "we did not record it".
  changedByUserId String?            @db.Uuid
  note            String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("ApplicationStatusActor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt(sort: Desc)])
  @@map("application_status_history")
}

/// Brief §18. A file attached to an application.
///
/// **The row is the record; the bytes are elsewhere.** §18 is explicit that raw uploads
/// do not belong in Postgres, and `storageKey` is the only link to them. Nothing in this
/// table can be used to reconstruct a file, which means a database dump handed to a
/// developer contains passport *metadata* and no passports.
///
/// `fileName` is what the uploader called it and is shown back to them. It is never used
/// to build a path: §83 says do not trust filenames, and `storageKey` is generated
/// server-side from a uuid precisely so a filename cannot escape its directory.
model Document {
  id               String         @id @default(uuid()) @db.Uuid
  applicationId    String         @db.Uuid
  uploadedByUserId String?        @db.Uuid
  type             DocumentType
  /// The uploader's own name for it. Display only.
  fileName         String
  /// Server-generated. The only thing that addresses the object.
  storageKey       String         @unique
  mimeType         String
  fileSize         Int
  status           DocumentStatus @default(PENDING)
  rejectionReason  String?
  reviewedByUserId String?        @db.Uuid
  reviewedAt       DateTime?      @db.Timestamptz(3)
  /// Set once the browser confirms the upload finished. A row without it is a presigned
  /// URL that was issued and never used, and it must not appear as a document.
  uploadedAt       DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User?       @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User?       @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("document")
}

/// What a document is for. A closed list rather than free text, because the review queue
/// groups by it and "Passport", "passport" and "Pasport" are three groups.
enum DocumentType {
  PASSPORT
  PHOTOGRAPH
  HIGH_SCHOOL_DIPLOMA
  HIGH_SCHOOL_TRANSCRIPT
  BACHELOR_DIPLOMA
  BACHELOR_TRANSCRIPT
  LANGUAGE_CERTIFICATE
  FINANCIAL_STATEMENT
  MEDICAL_REPORT
  OTHER

  @@map("document_type")
}

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  REQUIRES_REUPLOAD

  @@map("document_status")
}

/// Brief §24. Something that happened, addressed to one person.
///
/// Written in the same transaction as the thing it describes — see §51. A notification
/// sent for a status change that then rolled back is worse than none, because it tells
/// somebody their application moved when it did not.
///
/// `title` and `body` are stored rather than derived from `type` at read time. A
/// notification is a record of what somebody was told, and re-deriving the wording later
/// means the archive silently changes whenever the copy does.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Where it points. A relative path, never an absolute URL: an absolute one would
  /// carry whatever origin was configured when it was written.
  href      String?
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The unread badge and the list are the same query with and without a filter, so one
  /// composite index serves both.
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notification")
}

enum NotificationType {
  APPLICATION_STATUS
  DOCUMENT_REQUESTED
  DOCUMENT_REVIEWED
  MESSAGE_RECEIVED
  ACCOUNT
  PAYOUT

  @@map("notification_type")
}

/// Brief §25. A thread about an application.
///
/// **`internal` is the load-bearing field.** §25 says students must not have
/// unrestricted access to internal staff conversations, and the way that is guaranteed
/// here is that an internal thread may only have staff participants — enforced by a
/// database trigger, not by a filter each query has to remember.
///
/// The alternative, one thread with a per-message visibility flag, puts the applicant's
/// messages and staff's private notes in the same list and makes every read a filtering
/// problem. One missed filter then exposes an internal note about somebody to that
/// person.
model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String?  @db.Uuid
  subject       String?
  /// True for staff-only notes (§61's "Internal Notes"). False for a thread the
  /// applicant or their referrer can read.
  internal      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  application  Application?              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([applicationId, internal, updatedAt(sort: Desc)])
  @@map("conversation")
}

model ConversationParticipant {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  /// How far this person has read. Per participant, because "read" is a fact about a
  /// reader and not about a message.
  lastReadAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participant")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("message")
}

/// Brief §26. Who did what, to which record, and when.
///
/// Append-only, like `withdrawal_event` and `application_status_history`. This is the
/// table an incident review reads, and one that can be edited afterwards answers nothing.
///
/// **What must never appear in `metadata`:** passwords, session tokens, reset tokens,
/// claim codes, API keys. §26 says so and `logger.redact` already enforces the same list
/// on the way to the log; the service that writes here applies it too, because an audit
/// trail is the most durable place a leaked secret can land.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null for a system action. Nullable rather than absent so "nobody" is distinct from
  /// "we failed to record it".
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  /// Redacted before it is written. See `audit.service.ts`.
  metadata    Json?
  /// Truncated to a /24 or /48 by `ipPrefix`, matching what leads store. Enough to
  /// correlate a session, not enough to be a location record.
  ipPrefix    String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_log")
}

enum CommissionState {
  /// Earned but not yet confirmed by Campus Turkey. Counts toward `pendingMinor`.
  PENDING
  /// Confirmed and withdrawable. Counts toward `availableMinor`.
  CONFIRMED
  /// Reversed — the registration fell through. Counts toward nothing.
  REVERSED

  @@map("commission_state")
}

// --------------------------------------------------------------- payout methods

model PayoutMethod {
  id            String           @id @default(uuid()) @db.Uuid
  partnerId     String           @db.Uuid
  kind          PayoutMethodKind
  /// Display label, e.g. "GTBank". Never an account number.
  label         String
  /// Already masked when it arrives, e.g. "•••• 4417". The only account-shaped
  /// string this database is permitted to hold. See features/portal/payouts.ts.
  maskedDetail  String
  /// The provider's opaque handle for the vaulted instrument. Enough to initiate a
  /// payout, not enough to be worth stealing on its own. Never leaves the server.
  providerToken String
  providerName  String
  speed         String
  fee           String
  isDefault     Boolean          @default(false)
  /// Soft delete. A withdrawal references the method it paid to; hard-deleting one
  /// would tear a hole in the audit trail that a dispute needs.
  archivedAt    DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  /// Serves the list endpoint, which excludes archived rows.
  @@index([partnerId, archivedAt])
  @@map("payout_method")
}

enum PayoutMethodKind {
  BANK
  WISE
  STABLECOIN
  MOBILE_MONEY

  @@map("payout_method_kind")
}

// ------------------------------------------------------------------ withdrawals

model Withdrawal {
  id             String           @id @default(uuid()) @db.Uuid
  partnerId      String           @db.Uuid
  payoutMethodId String           @db.Uuid
  /// Human-readable, shown to the partner and quoted in support threads.
  reference      String           @unique
  amountMinor    Int
  currency       String           @db.Char(3)
  status         WithdrawalStatus @default(REQUESTED)
  /// Snapshot labels, resolved when the request is made. They describe what the
  /// partner was told they were withdrawing; recomputing them later would rewrite
  /// history every time the underlying commissions changed.
  period         String
  basis          String
  /// Client-generated, one per form session. Scoped to the partner: a key from one
  /// partner can never replay another's withdrawal. This single unique constraint
  /// is what makes a retry safe — see withdrawals.service.ts.
  idempotencyKey String
  /// The payout provider's reference, once money has actually moved.
  providerRef    String?
  requestedAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  partner      Partner           @relation(fields: [partnerId, currency], references: [id, currency], onDelete: Restrict)
  payoutMethod PayoutMethod      @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  events       WithdrawalEvent[]

  @@unique([partnerId, idempotencyKey])
  /// Serves the withdrawal list, which is always one partner's, newest first.
  /// Measured: at 300 withdrawals for one partner the planner uses this with an
  /// incremental sort. Below roughly 50 it sorts the partition instead, which is
  /// correct — sorting twenty rows costs less than an ordered index scan.
  @@index([partnerId, requestedAt(sort: Desc)])
  //
  // There was a `@@index([partnerId, status])` here, removed after reading the plan.
  // It overlapped `withdrawal_balance_committed` in migration 0002, and being the
  // cheaper of the two to enter, the planner picked it for the balance query — which
  // then needed a bitmap heap scan, because a plain index cannot answer for
  // `amountMinor`. With it gone the partial covering index wins and the aggregate
  // becomes an index-only scan. Nothing else queried `(partnerId, status)`: the list
  // endpoint orders by `requestedAt`. Two indexes on the same prefix cost write
  // throughput on every withdrawal for no read that needed them.
  @@index([payoutMethodId])
  @@map("withdrawal")
}

enum WithdrawalStatus {
  /// Created by the partner. Money has not moved.
  REQUESTED
  /// A human at Campus Turkey has approved it. Money has still not moved.
  APPROVED
  /// Handed to the payout provider.
  PROCESSING
  /// Settled. Terminal.
  PAID
  /// Refused, at any point before PAID. Terminal, and the only status that releases
  /// the amount back into the available balance.
  REJECTED

  @@map("withdrawal_status")
}

/// Append-only. Every status change writes one row and no row is ever updated or
/// deleted — the migration revokes UPDATE and DELETE on this table and installs a
/// trigger that raises on either. This is the record a payment dispute is settled
/// from, and a mutable audit trail is not an audit trail.
model WithdrawalEvent {
  id           String            @id @default(uuid()) @db.Uuid
  withdrawalId String            @db.Uuid
  /// Null on the row that records creation.
  fromStatus   WithdrawalStatus?
  toStatus     WithdrawalStatus
  /// Null when the actor is the system (a provider webhook, a scheduled job).
  actorUserId  String?           @db.Uuid
  /// Why, in the actor's words. Required on a rejection, which is the transition a
  /// partner will ask about.
  note         String?
  at           DateTime          @default(now()) @db.Timestamptz(3)

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  actor      User?      @relation("EventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([withdrawalId, at])
  @@index([actorUserId])
  @@map("withdrawal_event")
}

// ----------------------------------------------------------------------- leads

/// Every public form posts here: Apply, Contact, Partner registration,
/// Representative registration. One table discriminated by `kind` rather than four
/// near-identical tables, because the only thing that differs is the payload shape
/// and that is validated at the boundary by a per-kind Zod schema.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  kind           LeadKind
  /// Validated against the per-kind schema before it is written. Never rendered as
  /// HTML anywhere without escaping.
  payload        Json
  email          String
  /// Set when the visitor ticked the consent box. A lead with no consent timestamp
  /// must not be marketed to; the CHECK constraint requires one.
  consentAt      DateTime   @db.Timestamptz(3)
  /// Computed at write time from the retention policy for this `kind`. The purge job
  /// deletes on this column, so it is indexed. Medical enquiries carry health data
  /// and get the shortest window — see Department 18.6.
  retentionUntil DateTime   @db.Timestamptz(3)
  status         LeadStatus @default(NEW)
  /// Truncated to /24 (IPv4) or /48 (IPv6) before storage. Enough to investigate
  /// abuse, not enough to be a location record.
  ipPrefix       String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  /// The purge job: `WHERE retention_until < now()`.
  @@index([retentionUntil])
  @@index([kind, createdAt(sort: Desc)])
  @@map("lead")
}

enum LeadKind {
  APPLY
  CONTACT
  PARTNER
  REPRESENTATIVE
  /// Carries health information. Shortest retention, narrowest access.
  MEDICAL

  @@map("lead_kind")
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED

  @@map("lead_status")
}
