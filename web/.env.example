# Campus Turkey — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, and must never
# acquire a real value. Every variable below is validated at boot by server/lib/config.ts
# — the process refuses to start rather than failing on the first request that needed one.
#
# Legend:  [required]  always  ·  [prod]  required in production only  ·  [optional]


# ── Runtime ──────────────────────────────────────────────────────────────────────
# development | test | production. Set by the platform in deployed environments.
NODE_ENV=development


# ── Database ─────────────────────────────────────────────────────────────────────
# [required] Pooled connection, used by every request. On Neon or Supabase this is the
# URL with `-pooler` in the host. Serverless functions open a connection per invocation
# and a direct connection exhausts Postgres within minutes of real traffic.
DATABASE_URL=postgresql://user:password@host-pooler.region.provider.tech/campus_turkey?sslmode=require&pgbouncer=true&connection_limit=1

# [required] Direct (unpooled) connection. Used by `prisma migrate` only — migrations
# need a session-level connection that a transaction pooler cannot provide.
DIRECT_DATABASE_URL=postgresql://user:password@host.region.provider.tech/campus_turkey?sslmode=require


# ── Site ─────────────────────────────────────────────────────────────────────────
# [required] Public origin, no trailing slash. Canonical URLs, the sitemap, Open Graph
# tags, the cookie domain and the CSRF origin check all derive from this. Must be https
# in production — the session cookie is Secure-only.
SITE_ORIGIN=http://localhost:3000


# ── Authentication ───────────────────────────────────────────────────────────────
# [required] At least 32 characters. Generate with: openssl rand -base64 32
# Rotating this signs every session out, which is the intended behaviour in an incident.
SESSION_SECRET=

# ── Rate limiting ────────────────────────────────────────────────────────────────
# [prod] Upstash Redis. Required in production: this deploys to a serverless runtime
# where an in-process counter enforces the limit divided by the instance count, which
# is no limit at all. Free tier is sufficient at this traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Bot protection ───────────────────────────────────────────────────────────────
# [prod] turnstile | hcaptcha | disabled. Required in production — handoff note 13.
# The public lead forms collect passport-adjacent and, on the medical desk, health data.
CAPTCHA_PROVIDER=disabled
CAPTCHA_SECRET=


# ── Translation ──────────────────────────────────────────────────────────────────
# [optional] deepl | google | azure | disabled. When disabled, /api/translate returns
# 503 and the client stays in English — the designed degradation, not a failure.
#
# The key is server-side only. Never prefix it with NEXT_PUBLIC_, or it ships in the
# browser bundle and becomes someone else's translation budget.
TRANSLATE_PROVIDER=disabled
TRANSLATE_API_KEY=
TRANSLATE_ENDPOINT=https://api-free.deepl.com/v2/translate


# ── Payouts ──────────────────────────────────────────────────────────────────────
# [optional] wise | airwallex | flutterwave | unconfigured.
# Blocked on client open question 3 (which provider). While unconfigured, the
# payout-method endpoints return 422 with an explanation rather than pretending to work.
#
# PAYOUT_WEBHOOK_SECRET is not optional once a provider is set: an unverified webhook
# endpoint is an unauthenticated write endpoint that can mark a withdrawal as paid.
# It signs `${timestamp}.${body}` with HMAC-SHA256; point the provider's callback at
# POST /api/webhooks/payouts and configure it to send `x-signature` and `x-timestamp`.
PAYOUT_PROVIDER=unconfigured
PAYOUT_API_BASE=
PAYOUT_API_KEY=
PAYOUT_WEBHOOK_SECRET=


# ── Transactional mail ───────────────────────────────────────────────────────────
# [optional] resend | postmark | disabled. Transactional only — no marketing sends.
MAIL_PROVIDER=disabled
MAIL_API_KEY=
MAIL_FROM=


# ── Scheduled jobs ───────────────────────────────────────────────────────────────
# [prod] Bearer token for /api/cron/purge-leads, which hard-deletes leads past their
# retention date. Vercel Cron sends this automatically once the variable is set; the
# route compares it in constant time and refuses everything else.
#
# Generate with: openssl rand -base64 32
# Without it the endpoint returns 503 and the purge never runs — which means personal
# data is retained past the window you promised, so treat this as required at launch.
CRON_SECRET=


# ── Observability ────────────────────────────────────────────────────────────────
# [prod] Required in production. Without it, caught boundary errors go unrecorded and
# the first report of an outage is a partner emailing about their payout.
SENTRY_DSN=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info


# ── Maintenance ──────────────────────────────────────────────────────────────────
# on | off. When on, middleware.ts returns 503 with Retry-After from the edge, before
# the app bundle is involved — handoff note 12. /api/health stays reachable so the
# platform can tell "deliberately down" from "fell over".
MAINTENANCE_MODE=off
MAINTENANCE_RETRY_AFTER_SECONDS=600


# ── Map tiles ────────────────────────────────────────────────────────────────────
# [prod] Handoff note 13: OpenStreetMap asks that production traffic use a paid tile
# host. MapTiler, Mapbox or self-hosted. The value is added to the CSP img-src.
MAP_TILE_HOST=
